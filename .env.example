# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Admin Portal Passcode Protection ---
# Set the secret master PIN to access the Covai Meter Taxi Admin Console:
VITE_ADMIN_PIN=1234

# --- Firebase Configuration (Client-side Vite environment variables) ---
# Configure your Firebase project credentials here to sync driver records with your Android app:
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=

